apiVersion: apps/v1
kind: Deployment
metadata:
  name: ai-dev-agent
spec:
  replicas: 2
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app: ai-dev-agent
  template:
    metadata:
      labels:
        app: ai-dev-agent
    spec:
      containers:
        - name: ai-dev-agent
          image: ai-dev-agent:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 8080
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 15
            periodSeconds: 10
